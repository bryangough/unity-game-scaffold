/[Aa]ssets/[Ss]treamingAssets/aa/*
**/.DS_Store

# Android build temp (Gradle / CMake)
.utmp/

# A WebGL build leaves this at the project root
/Data/

# The music bundles, built per platform before every player build (Editor/MusicBundles.cs)
/[Aa]ssets/StreamingAssets/Music/
/[Aa]ssets/StreamingAssets/Music.meta
# and the web build's MP3 stems, encoded from the music before a web build
/[Aa]ssets/Game/Audio/WebMusic/
/[Aa]ssets/Game/Audio/WebMusic.meta

# TextMesh Pro's essential resources are Unity's: imported by Setup, never committed
/[Aa]ssets/TextMesh Pro/
/[Aa]ssets/TextMesh Pro.meta

# Store screenshots are kept; signing keys never live in the repo (they go to %USERPROFILE%/.keys/<game>)
*.keystore
signing.txt
